{
  "name": "Claude Code Sandbox",
  "build": {
    "dockerfile": "./Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:America/Sao_Paulo}",
      "CLAUDE_CODE_VERSION": "latest",
      "GIT_DELTA_VERSION": "0.18.2",
      "ZSH_IN_DOCKER_VERSION": "1.2.0"
    }
  },
  "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW", "--env-file", "${localWorkspaceFolder}/.devcontainer/.env"],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens",
        "github.vscode-pull-request-github",
        "Shopify.ruby-lsp",
        "hashicorp.terraform"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/node/.pyenv/versions/3.12.13/bin/python3",
        "terraform.languageServer.terraform.path": "/usr/local/bin/terraform",
        "[terraform]": {
          "editor.defaultFormatter": "hashicorp.terraform",
          "editor.formatOnSave": true
        },
        "[terraform-vars]": {
          "editor.defaultFormatter": "hashicorp.terraform",
          "editor.formatOnSave": true
        }
      }
    }
  },
  "remoteUser": "node",
  "mounts": [
    "source=claude-code-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=claude-code-home-${devcontainerId},target=/home/node,type=volume",
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
    // Docker Desktop users: uncomment the lines below for SSH agent forwarding (OrbStack handles this automatically)
    // "source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind"
  ],
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}",
    // Docker Desktop users: uncomment the line below if you added the SSH mount above
    // "SSH_AUTH_SOCK": "/ssh-agent",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",

  // "postStartCommand": "sudo /usr/local/bin/init-firewall.sh && sudo /usr/local/bin/init-docker.sh",
  "postStartCommand": "sudo /usr/local/bin/init-docker.sh",
  "waitFor": "postStartCommand"
}
